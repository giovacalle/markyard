{
  "name": "markyard",
  "description": "Self-hosted, offline-first Markdown notes PWA backed by Google Drive on Cloudflare Workers",
  "license": "MIT",
  "homepage": "https://markyard.giova.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/giovacalle/markyard.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:mock": "node scripts/mock-api.mjs",
    "build": "pnpm --dir web build && pnpm --dir bff check",
    "check:web": "node scripts/check-csp-source.mjs && node scripts/check-test-timeouts.mjs && pnpm --dir web check",
    "test:web": "pnpm --dir web test",
    "check:bff": "pnpm --dir bff check",
    "test:bff": "pnpm --dir bff test",
    "test:scripts": "node --test scripts/check-csp-source.test.mjs scripts/check-test-timeouts.test.mjs scripts/mock-api.test.mjs"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  }
}
